{
  "permissions": {
    "allow": [
      "Bash(zip *)",
      "Bash(cp *)",
      "Bash(mkdir *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/vishwasjayarama/.local/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/vishwasjayarama/.local/bin/graphify hook-guard read"
          }
        ]
      }
    ]
  }
}